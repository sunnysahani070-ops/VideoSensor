# ========================================================
# VideoSensor Platform - Environment Configuration
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://videosensor.com

# Database Configuration (Neon Serverless Postgres / Supabase / Aiven)
# Leave blank to use in-memory and local disk fallback
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/videosensor_db?sslmode=require

# Storage Backend Mode ('local' or 'r2')
STORAGE_MODE=local

# Cloudflare R2 / S3 Object Storage Configuration
# Find these under Cloudflare Dashboard > R2 > Manage R2 API Tokens
S3_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=videosensor-streams
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_PUBLIC_BASE_URL=https://cdn.videosensor.com
S3_FORCE_PATH_STYLE=false

# Security & JWT Secrets
JWT_SECRET=super_secret_videosensor_jwt_key_change_me_in_prod

# Google AdSense / Programmatic Advertising Slot ID
ADSENSE_CLIENT_ID=ca-pub-992019284729104
ADSENSE_SLOT_LEADERBOARD=1234567890
ADSENSE_SLOT_SIDEBAR=0987654321
